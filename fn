def fibonacci_sequence(n):
    fib_list = [0, 1]
    if n <= 2:
        return fib_list[:n]
    for i in range(2, n):
        next_fib = fib_list[i - 1] + fib_list[i - 2]
        fib_list.append(next_fib)
    return fib_list

num_terms = int(input("Enter the number of Fibonacci numbers to generate: "))
print(fibonacci_sequence(num_terms))
